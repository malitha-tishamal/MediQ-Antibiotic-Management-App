# Cloudinary Configuration
# Duplicate this file as .env and fill in your actual Cloudinary credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_UPLOAD_PRESET=your_upload_preset_here

# Default Profile Picture URLs
CLOUDINARY_ADMIN_DEFAULT_URL=https://res.cloudinary.com/your_cloud_name_here/image/upload/v1776579551/admin-default_rloii1.jpg
CLOUDINARY_PHARMACIST_DEFAULT_URL=https://res.cloudinary.com/your_cloud_name_here/image/upload/v1776579551/pharmizist-default_weoaaq.jpg
